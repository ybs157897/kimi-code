{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": ".tmp-api-extractor/dts",
    "rootDir": ".."
  },
  "include": [
    "src/**/*.ts",
    "../kaos/src/**/*.ts",
    "../kosong/src/**/*.ts",
    "../oauth/src/**/*.ts",
    "../agent-core-v2/src/env.d.ts"
  ],
  "exclude": [
    "dist",
    ".tmp-api-extractor",
    "examples",
    "test",
    "src/v2",
    "../*/dist",
    "../*/test"
  ]
}
