{
  "name": "@moonshot-ai/kimi-code-sdk",
  "version": "0.14.0",
  "private": true,
  "description": "TypeScript SDK for the Kimi Code Agent",
  "license": "MIT",
  "author": "Moonshot AI",
  "homepage": "https://github.com/MoonshotAI/kimi-code/tree/main/packages/node-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonshotAI/kimi-code.git",
    "directory": "packages/node-sdk"
  },
  "bugs": {
    "url": "https://github.com/MoonshotAI/kimi-code/issues"
  },
  "keywords": [
    "kimi",
    "sdk",
    "typescript",
    "agent",
    "api"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./v2": {
      "types": "./src/v2/index.ts",
      "default": "./src/v2/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./v2": {
        "types": "./dist/v2/index.d.ts",
        "import": "./dist/v2/index.mjs",
        "default": "./dist/v2/index.mjs"
      }
    },
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && pnpm run build:dts && pnpm run build:dts:v2",
    "build:dts": "node scripts/build-dts.mjs",
    "build:dts:v2": "tsc6 --ignoreConfig --target ES2024 --module preserve --moduleResolution bundler --lib ESNext --types node --strict --verbatimModuleSyntax --experimentalDecorators --declaration --emitDeclarationOnly --noEmitOnError --skipLibCheck --rootDir src/v2 --outDir dist/v2 ../agent-core-v2/src/env.d.ts src/v2/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .tmp-api-extractor"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "smol-toml": "^1.6.1",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@moonshot-ai/agent-core-v2": "workspace:^",
    "@moonshot-ai/kaos": "workspace:^",
    "@moonshot-ai/kimi-code-oauth": "workspace:^",
    "@moonshot-ai/klient": "workspace:^",
    "@moonshot-ai/kosong": "workspace:^",
    "@moonshot-ai/protocol": "workspace:^",
    "@types/yazl": "^2.4.6",
    "jimp": "^1.6.1"
  }
}
